<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Phase 0 test projects are intentionally empty. MTP exits 8 for "zero tests ran"; treat that as success.
         Real failures (exit code 2) still fail the run. -->
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>
</Project>
