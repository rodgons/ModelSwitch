# Serves the dashboard's static build inside the `web` container. The `proxy` service (deploy/Caddyfile) sits in front of it
# and adds the security headers; this server only serves files.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Vite fingerprints everything under /assets, so it can be cached for good. index.html must never be cached.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@index path / /index.html
	header @index Cache-Control "no-cache"

	# History-mode routes (/requests/…) are client-side: unknown paths get index.html.
	try_files {path} /index.html
	file_server
}
