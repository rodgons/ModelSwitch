{
  "name": "modelswitch-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "generate:api": "openapi-typescript openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "check:api": "pnpm generate:api && git diff --exit-code -- src/api/schema.d.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/vue-query": "5.104.1",
    "echarts": "6.1.0",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "primevue": "4.5.5",
    "vue": "^3.5.44",
    "vue-echarts": "8.3.2",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
