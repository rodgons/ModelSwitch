# Copy to `.env`, then run ./scripts/generate-secrets.sh, which replaces every CHANGE_ME secret below (and leaves the rest).
# Every variable is documented in docs/deployment.md section 3. Never commit the filled-in `.env`.
# Compose expands ${VAR} references inside this file, so each password is written once.

# --- PostgreSQL (container bootstrap and roles). Generated passwords are hex, safe inside connection strings. ---
POSTGRES_DB=modelswitch
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME
POSTGRES_APP_PASSWORD=CHANGE_ME
# Lets the worker's retention job connect as modelswitch_retention (and delete expired Audit Records).
POSTGRES_RETENTION_PASSWORD=CHANGE_ME

# PostgreSQL's max_connections (Compose passes it to the postgres container). Keep it above the pools below; see docs/deployment.md
# section 3, "Connection budget".
POSTGRES_MAX_CONNECTIONS=200

# --- Connection strings (host names are the Compose services) ---
# GSS encryption is off: the chiseled images have no Kerberos library, and Npgsql would otherwise probe for it on every connect.
# Maximum Pool Size caps each Npgsql pool built from the string (Npgsql's default is 100). The api and the worker each open two
# pools from the app string, so with 40 they hold at most 81 and 86 connections, under POSTGRES_MAX_CONNECTIONS with headroom.
MODELSWITCH__ConnectionStrings__Postgres=Host=postgres;Database=${POSTGRES_DB};Username=modelswitch_app;Password=${POSTGRES_APP_PASSWORD};GSS Encryption Mode=Disable;Maximum Pool Size=40
MODELSWITCH__ConnectionStrings__PostgresMigrator=Host=postgres;Database=${POSTGRES_DB};Username=modelswitch_migrator;Password=${POSTGRES_MIGRATOR_PASSWORD};GSS Encryption Mode=Disable;Maximum Pool Size=5
MODELSWITCH__ConnectionStrings__PostgresRetention=Host=postgres;Database=${POSTGRES_DB};Username=modelswitch_retention;Password=${POSTGRES_RETENTION_PASSWORD};GSS Encryption Mode=Disable;Maximum Pool Size=5
MODELSWITCH__ConnectionStrings__Valkey=valkey:6379

# --- Security (32 random bytes, base64) ---
MODELSWITCH__Security__MasterKey=CHANGE_ME
MODELSWITCH__Security__ApiKeyPepper=CHANGE_ME
# MODELSWITCH__Security__MasterKeyVersion=1

# --- First-run Owner (ignored once an Administrator exists). The password needs at least 12 characters. ---
MODELSWITCH__Bootstrap__OwnerEmail=
MODELSWITCH__Bootstrap__OwnerPassword=

# --- Hosting ---
# The published port of the proxy, and the URL browsers use to reach it.
MODELSWITCH_HTTP_PORT=8080
MODELSWITCH__Hosting__PublicBaseUrl=http://localhost:8080
# MODELSWITCH__Hosting__EndpointGroups=inference,admin

# --- Limits ---
# MODELSWITCH__Limits__FailureMode=Closed
# MODELSWITCH__Limits__MaxRequestBodyBytes=1048576

# --- Outbound: http and private addresses are allowed only for these hosts ---
MODELSWITCH__Outbound__AllowedPrivateHosts=ollama,mock-provider

# --- Retention ---
# MODELSWITCH__Retention__RequestDays=30

# --- Telemetry (unset endpoint = no export) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
# MODELSWITCH__Telemetry__TraceUrlTemplate=

# --- Provider credentials, referenced as env:NAME ---
# OPENAI_API_KEY=
