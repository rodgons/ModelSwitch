# Copy to `.env` and fill in. Every variable is documented in docs/deployment.md §3.
# Values marked CHANGE_ME must be replaced; never commit the filled-in `.env`.

# --- PostgreSQL (container bootstrap) ---
POSTGRES_DB=modelswitch
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME
POSTGRES_APP_PASSWORD=CHANGE_ME

# --- Connection strings ---
MODELSWITCH__ConnectionStrings__Postgres=Host=postgres;Database=modelswitch;Username=modelswitch_app;Password=CHANGE_ME
MODELSWITCH__ConnectionStrings__PostgresMigrator=Host=postgres;Database=modelswitch;Username=modelswitch_migrator;Password=CHANGE_ME
MODELSWITCH__ConnectionStrings__Valkey=valkey:6379

# --- Security (32 random bytes, base64: `openssl rand -base64 32`) ---
# MasterKey is required once any Provider uses a `db:` credential.
MODELSWITCH__Security__MasterKey=
MODELSWITCH__Security__ApiKeyPepper=CHANGE_ME

# --- First-run Owner (ignored once an Administrator exists) ---
MODELSWITCH__Bootstrap__OwnerEmail=
MODELSWITCH__Bootstrap__OwnerPassword=

# --- Hosting ---
MODELSWITCH__Hosting__PublicBaseUrl=http://localhost:8080
# MODELSWITCH__Hosting__EndpointGroups=inference,admin

# --- Limits ---
# MODELSWITCH__Limits__FailureMode=Closed
# MODELSWITCH__Limits__MaxRequestBodyBytes=1048576

# --- Outbound ---
MODELSWITCH__Outbound__AllowedPrivateHosts=ollama,mock-provider

# --- Retention ---
# MODELSWITCH__Retention__RequestDays=30

# --- Telemetry (unset endpoint = no export) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
# MODELSWITCH__Telemetry__TraceUrlTemplate=

# --- Provider credentials, referenced as env:NAME ---
# OPENAI_API_KEY=
